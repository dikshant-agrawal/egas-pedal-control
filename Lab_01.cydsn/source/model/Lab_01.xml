<?xml version="1.0" encoding="utf-8"?>
<rte>
 <configset>
  <config name="version" value="Erika 2"/>
  <config name="path_out" value="{PROJECT_PATH}\.."/>
  <config name="templateDir" value="{GEN_PATH}\..\templates\erika"/>
  <config name="userCodeStart" value="/\* USER CODE START {TAG} \*/"/>
  <config name="userCodeEnd" value="/\* USER CODE END {TAG} \*/"/>
  <config name="guivers" value="0.1.2"/>
 </configset>
 <naming>
  <config name="signalpoolPrefix" value="sp_"/>
  <config name="signalpoolPostfix" value=""/>
  <config name="taskPrefix" value="tsk_"/>
  <config name="taskPostfix" value=""/>
  <config name="signalclassPrefix" value="sc_"/>
  <config name="signalclassPostfix" value=""/>
  <config name="signalobjectPrefix" value="so_"/>
  <config name="signalobjectPostfix" value=""/>
  <config name="swcPrefix" value="swc_"/>
  <config name="swcPostfix" value=""/>
  <config name="runnablePrefix" value=""/>
  <config name="runnablePostfix" value="_run"/>
  <config name="eventPrefix" value="ev_"/>
  <config name="eventPostfix" value=""/>
  <config name="resourcePrefix" value="res_"/>
  <config name="resourcePostfix" value=""/>
  <config name="addrPrefix" value="ADR_"/>
  <config name="addrStartPostfix" value="_START"/>
  <config name="addrEndPostfix" value="_END"/>
 </naming>
 <signalpools>
  <signalpool description="The one and only signal pool, used for all signals" endaddr="ADR_SP_COMMON_END" name="sp_common" shortname="common" startaddr="ADR_SP_COMMON_START"/>
 </signalpools>
 <tasks>
  <task description="Task will call the application code" events="ev_joystick_onData" mode="Event" name="tsk_control" shortname="control" signalpoolsRO="sp_common" signalpoolsRW="sp_common" tickEvent="0" timertickperiod="1"/>
  <task description="Non realtime task for updating HMI" events="ev_1ms_tick" mode="Cyclic" name="tsk_hmi" shortname="hmi" signalpoolsRO="sp_common" signalpoolsRW="sp_common" tickEvent="ev_1ms_tick" timertickperiod="1"/>
  <task description="Task for IO handling" events="ev_brake_onData|ev_1ms_tick" mode="Cyclic" name="tsk_io" shortname="io" signalpoolsRO="sp_common" signalpoolsRW="sp_common" tickEvent="ev_1ms_tick" timertickperiod="1"/>
 </tasks>
 <signalclasses>
  <signalclass description="Signalclass for joystick data" name="sc_joystick" shortname="joystick"/>
  <signalclass description="Signalclass repreenting the motion of the car in x y and fi direction" name="sc_speed" shortname="speed"/>
  <signalclass description="Signalclass" name="sc_enable" shortname="enable"/>
  <signalclass description="Signalclass represting the engine speed in rpm" name="sc_enginespeed" shortname="enginespeed"/>
  <signalclass description="Signalclass to store the timing from ISR" name="sc_timeArray" shortname="timeArray"/>
  <signalclass description="Signalclass to display on HMI" name="sc_display" shortname="display"/>
 </signalclasses>
 <signalobjects>
  <signalobject description="x,y value of joystick" indriver="0" name="so_joystick" onDataError="0" onDataUpdate="ev_joystick_onData" outdriver="0" resource="None" shortname="joystick" signalclass="sc_joystick" signalpool="sp_common"/>
  <signalobject description="A Signal for target speed" indriver="0" name="so_targetSpeed" onDataError="0" onDataUpdate="0" outdriver="0" resource="None" shortname="targetSpeed" signalclass="sc_speed" signalpool="sp_common"/>
  <signalobject description="A Signal reported by the engine decoder" indriver="default" name="so_currentSpeed" onDataError="0" onDataUpdate="0" outdriver="0" resource="None" shortname="currentSpeed" signalclass="sc_speed" signalpool="sp_common"/>
  <signalobject description="A Signal to provide the control speed to the engine" indriver="0" name="so_controlSpeed" onDataError="0" onDataUpdate="0" outdriver="default" resource="None" shortname="controlSpeed" signalclass="sc_speed" signalpool="sp_common"/>
  <signalobject description="A Signal object for enable signal to engine" indriver="0" name="so_enableEngine" onDataError="0" onDataUpdate="0" outdriver="default" resource="None" shortname="enableEngine" signalclass="sc_enable" signalpool="sp_common"/>
  <signalobject description="A Signal object from joystick" indriver="default" name="so_break" onDataError="0" onDataUpdate="0" outdriver="0" resource="None" shortname="break" signalclass="sc_enable" signalpool="sp_common"/>
  <signalobject description="A Signal" indriver="0" name="so_array" onDataError="0" onDataUpdate="0" outdriver="0" resource="None" shortname="array" signalclass="sc_timeArray" signalpool="sp_common"/>
  <signalobject description="A Signal" indriver="0" name="so_display" onDataError="0" onDataUpdate="0" outdriver="default" resource="None" shortname="display" signalclass="sc_display" signalpool="sp_common"/>
  <signalobject description="A Signal for adc values" indriver="default" name="so_adc" onDataError="0" onDataUpdate="0" outdriver="0" resource="None" shortname="adc" signalclass="sc_joystick" signalpool="sp_common"/>
 </signalobjects>
 <swcs>
  <swc description="Software component for egas pedal which takes ADC values and also controls the engine speed" name="swc_eGas" shortname="eGas"/>
 </swcs>
 <runnables>
  <runnable component="swc_eGas" cycletime="10" description="read joystick data" events="" name="EGAS_readJoystick_run" shortname="readJoystick" signalIN="" signalOUT="so_joystick" task="tsk_io"/>
  <runnable component="swc_eGas" cycletime="0" description="Runnable" events="ev_joystick_onData" name="EGAS_control_run" shortname="control" signalIN="so_joystick" signalOUT="so_targetSpeed" task="tsk_control"/>
  <runnable component="swc_eGas" cycletime="100" description="Engine controller PWM runnable" events="" name="EGAS_controlEngine_run" shortname="controlEngine" signalIN="so_targetSpeed|so_currentSpeed" signalOUT="so_targetSpeed|so_currentSpeed|so_controlSpeed" task="tsk_io"/>
  <runnable component="swc_eGas" cycletime="100" description="Runnable" events="" name="EGAS_hmi_run" shortname="hmi" signalIN="so_targetSpeed|so_currentSpeed" signalOUT="so_display" task="tsk_hmi"/>
  <runnable component="swc_eGas" cycletime="10" description="Runnable" events="ev_brake_onData" name="EGAS_brake_run" shortname="brake" signalIN="" signalOUT="so_enableEngine" task="tsk_io"/>
 </runnables>
 <events>
  <event description="A Event" name="ev_joystick_onData" shortname="joystick_onData"/>
  <event description="A Event" name="ev_brake_onData" shortname="brake_onData"/>
  <event description="A Event" name="ev_1ms_tick" shortname="1ms_tick"/>
 </events>
 <resources/>
</rte>
